#!/bin/sh

set -eu

sed -i \
  -e 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' \
  -e 's/^# *zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' \
  /etc/locale.gen
locale-gen
update-locale LANG=en_US.UTF-8

passwd --lock root
chmod 0440 /etc/sudoers.d/010_lc300a-live
chmod 0755 /usr/libexec/lc300a/boot-ready
chmod 0755 /usr/libexec/lc300a/desktop-ready /usr/libexec/lc300a/session-sound \
  /usr/libexec/lc300a/start-kwin-wayland /usr/libexec/lc300a/start-plasmashell
chmod 0755 /usr/local/bin/plasma-discover
chmod 0755 /usr/local/bin/lc300a-welcome /usr/local/bin/lc300a-welcome-action
update-desktop-database /usr/share/applications
apt-get update -o Acquire::IndexTargets::deb::DEP-11::DefaultEnabled=true
appstreamcli refresh --force --source=os
plymouth-set-default-theme lc300a
update-initramfs -u
systemctl enable NetworkManager.service
systemctl enable lc300a-boot-ready.service
systemctl enable sddm.service
systemctl enable lc300a-desktop-ready.service
systemctl set-default graphical.target

rm -f /var/lib/dbus/machine-id
: >/etc/machine-id
