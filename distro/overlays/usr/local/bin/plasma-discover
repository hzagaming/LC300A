#!/bin/sh

set -eu

for argument in "$@"; do
  case $argument in
    --listbackends|--backends|--backends=*) exec /usr/bin/plasma-discover "$@" ;;
  esac
done

backends=packagekit-backend
if command -v flatpak >/dev/null 2>&1; then
  if flatpak remotes --system --columns=name 2>/dev/null | grep -q . ||
    flatpak remotes --user --columns=name 2>/dev/null | grep -q .; then
    backends="$backends,flatpak-backend"
  fi
fi

exec /usr/bin/plasma-discover --backends "$backends" "$@"
