#!/bin/sh

set -eu

if [ ! -e /run/live/medium/live/filesystem.squashfs ]; then
    command -v kdialog >/dev/null 2>&1 && \
        kdialog --error "安装器只能从落川OS Live 系统启动。"
    exit 1
fi

fstab_moved=0
xhost_open=0
restore_fstab() {
    if [ "$xhost_open" -eq 1 ]; then
        xhost -si:localuser:root >/dev/null 2>&1 || true
    fi
    if [ "$fstab_moved" -eq 1 ] && [ -e /etc/fstab.orig.calamares ]; then
        sudo mv /etc/fstab.orig.calamares /etc/fstab
    fi
}
trap restore_fstab EXIT HUP INT TERM

if [ -e /etc/fstab ]; then
    [ ! -e /etc/fstab.orig.calamares ] || exit 1
    sudo mv /etc/fstab /etc/fstab.orig.calamares
    fstab_moved=1
fi

export QT_AUTO_SCREEN_SCALE_FACTOR=1
xhost +si:localuser:root >/dev/null
xhost_open=1
sudo -E systemd-inhibit \
    --what=idle:sleep \
    --who="LC300A Installer" \
    --why="LC300A installation is in progress" \
    --mode=block \
    calamares "$@"
