#!/bin/sh

set -eu

state_root=${XDG_CONFIG_HOME:-"$HOME/.config"}/lc300a
state_file=$state_root/welcome-complete

wait_for_plasma() {
  command -v qdbus6 >/dev/null 2>&1 || return 0
  attempt=0
  while [ "$attempt" -lt 120 ]; do
    if qdbus6 org.kde.plasmashell /PlasmaShell org.freedesktop.DBus.Peer.Ping \
      >/dev/null 2>&1 && ! pgrep -x ksplashqml >/dev/null 2>&1; then
      sleep 1
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
}

case ${1:-} in
  "") ;;
  --first-login)
    [ ! -d /run/live/medium ] || exit 0
    [ ! -f "$state_file" ] || [ "$(cat "$state_file")" != "completed=true" ] || exit 0
    wait_for_plasma
    ;;
  *)
    printf '%s\n' "用法: lc300a-welcome [--first-login]" >&2
    exit 2
    ;;
esac

qml=/usr/lib/qt6/bin/qml
[ -x "$qml" ] || {
  printf '%s\n' "LC300A welcome requires qml-qt6" >&2
  exit 1
}

exec "$qml" /usr/share/lc300a-welcome/Main.qml
