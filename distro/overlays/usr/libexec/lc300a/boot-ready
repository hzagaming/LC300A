#!/bin/sh

set -eu

config=/etc/live/config.conf.d/lc300a.conf
marker=LC300A_BOOT_OK
console_marker=LC300A_CONSOLE_OK

write_marker() {
  printf '%s\n' "$1"
  if [ -w /dev/ttyS0 ]; then
    printf '%s\n' "$1" >/dev/ttyS0
  fi
}

# shellcheck source=/dev/null
. "$config"
id "$LIVE_USERNAME" >/dev/null
test -d "/home/$LIVE_USERNAME"
user_shell=$(getent passwd "$LIVE_USERNAME" | cut -d: -f7)
case $user_shell in
  /bin/bash|/bin/sh) ;;
  *) exit 1 ;;
esac
id -nG "$LIVE_USERNAME" | tr ' ' '\n' | grep -qx sudo

write_marker "$marker"
if grep -Fqw 'systemd.unit=multi-user.target' /proc/cmdline; then
  write_marker "$console_marker"
fi
